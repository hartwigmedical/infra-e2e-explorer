# Multi-stage: build the client + the React Router server build + the Express
# SSR shim, then run a non-root runtime carrying a PRODUCTION node_modules, the
# build output, and the shim. See README "Docker".
#
# NOTE (SSR experiment, Phase 2): under SSR the runtime must ship the app's
# production deps (react, react-dom, react-router, @react-router/*, native
# @duckdb/node-api, @google-cloud/storage, …) — the shim (build/index.mjs) and
# the RR server build (build/server) both resolve react-router from node_modules
# at runtime, so bundling is no longer possible. Alpine is kept because DuckDB
# ships musl bindings (@duckdb/node-bindings-linux-*-musl), which npm resolves
# for this platform automatically. This Dockerfile is NOT yet built/validated in
# CI — that's Phase 5 (base-image + Cloud Run memory sizing).

# ---------- Builder ----------
FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# build/client + build/server (react-router build), then build/index.mjs (the
# Express SSR shim; packages kept external — see scripts/build-server.mjs).
RUN npm run build && npm run build:server

# Prune to production deps in place, so the runtime carries only what SSR needs
# at runtime (keeps the platform-matched native duckdb binary that npm ci
# already resolved for this image's OS/arch/libc).
RUN npm prune --omit=dev

# ---------- Runtime ----------
FROM node:24-alpine

WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/build ./build

# Drop root: the node:alpine image ships an unprivileged `node` user (uid 1000).
USER node

# Reports are read from the bucket via Application Default Credentials (workload
# identity in Cloud Run / GKE) — no key file or hardcoded service account.
EXPOSE 3001

CMD ["node", "build/index.mjs"]
