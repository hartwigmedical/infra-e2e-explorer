# Multi-stage: build the client + the React Router server build + the Express
# SSR shim, then run a non-root runtime carrying a PRODUCTION node_modules, the
# build output, and the shim. See README "Docker".
#
# NOTE: under SSR the runtime must ship the app's production deps (react,
# react-dom, react-router, @react-router/*, native @duckdb/node-api,
# @google-cloud/storage, …) — the shim (build/index.mjs) and the RR server build
# (build/server) both resolve react-router from node_modules at runtime, so
# bundling is no longer possible. Alpine is kept because DuckDB ships musl
# bindings (@duckdb/node-bindings-linux-*-musl), which npm resolves for this
# platform automatically.
#
# Validated for the 0.6.0 release: built --platform linux/amd64 and smoke-tested
# against the live bucket — GCS listing, download, DuckDB extraction and all SSR
# routes work under the non-root user. ~100 MB compressed / ~364 MB on disk, of
# which 202 MB is the production node_modules the note above explains. Not yet
# run in Cloud Build, and Cloud Run memory is still unsized (~330 MB RSS with a
# 3-day window; production defaults to 90 days).

# ---------- Builder ----------
FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# build/client + build/server (react-router build), then build/index.mjs (the
# Express SSR shim; packages kept external — see scripts/build-server.mjs).
RUN npm run build && npm run build:server

# Prune to production deps in place, so the runtime carries only what SSR needs
# at runtime (keeps the platform-matched native duckdb binary that npm ci
# already resolved for this image's OS/arch/libc).
RUN npm prune --omit=dev

# ---------- Runtime ----------
FROM node:24-alpine

WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/build ./build

# The slim-Parquet cache (server/data/cache.ts). Everything COPY'd above is
# root-owned, so the dir must be created and handed to `node` explicitly —
# otherwise every extraction fails with EACCES. Set explicitly rather than left
# to the code's default so a deployment that mounts a shared (gcsfuse) cache
# overrides one obvious variable.
ENV E2E_CACHE_DIR=/app/.cache
RUN mkdir -p /app/.cache && chown node:node /app/.cache

# libuv's threadpool (default 4) is shared by every fs operation AND by DuckDB's
# work: extraction runs up to 6 concurrent COPY statements, which would otherwise
# leave nothing for the loader queries and cache reads a request needs. Keep this
# above the extraction concurrency in server/data/cache.ts.
ENV UV_THREADPOOL_SIZE=8

# Drop root: the node:alpine image ships an unprivileged `node` user (uid 1000).
USER node

# Reports are read from the bucket via Application Default Credentials (workload
# identity in Cloud Run / GKE) — no key file or hardcoded service account.
EXPOSE 3001

CMD ["node", "build/index.mjs"]
